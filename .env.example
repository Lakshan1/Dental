# Copy this file to ".env" (same folder) and fill in your real values.
# ".env" is gitignored - it never gets committed. This file (.env.example)
# has no real secrets in it, so it's safe to commit as a template.
#
# Leave any of these blank to disable that notification - EmailService /
# SmsService just skip sending and log when they're unset.

# Brevo (https://app.brevo.com) - Settings > SMTP & API > API Keys
BREVO_API_KEY=
# Must be a sender address verified in your Brevo account
BREVO_SENDER_EMAIL=noreply@sunrisedental.com
BREVO_SENDER_NAME=Sunrise Dental Clinic

# notify.lk (https://app.notify.lk) - Settings > API
NOTIFYLK_USER_ID=
NOTIFYLK_API_KEY=
# Your approved sender id, or "NotifyDEMO" while on a trial account
NOTIFYLK_SENDER_ID=NotifyDEMO
